# Firebase Realtime Database Configuration
# Copy this file to .env or replace the credentials inside script.js

FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-app-id-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-app-id
FIREBASE_STORAGE_BUCKET=your-app-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Server / Port configuration for local testing
PORT=8000
